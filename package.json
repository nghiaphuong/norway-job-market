{
  "name": "norway-job-market",
  "version": "1.0.0",
  "private": true,
  "description": "Daily pipeline and dashboard analysing every open job ad in Norway (NAV), with a deep-dive into data, business-analysis and project roles.",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "ingest": "node ingest/run.mjs",
    "ingest:full": "node ingest/run.mjs --full",
    "reextract": "node ingest/run.mjs --reextract",
    "check": "node ingest/check.mjs",
    "build": "node ingest/build.mjs",
    "test": "node --test test/rules.test.mjs",
    "serve": "node serve.mjs"
  },
  "license": "MIT"
}
